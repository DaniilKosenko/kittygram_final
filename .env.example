# .env.example
# Этот файл лежит в GitHub. Он показывает, какие переменные нужны.
# Реальные пароли сюда НЕ писать!

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_database_name

DB_HOST=db
DB_PORT=5432

SECRET_KEY=change_this_to_your_secret_key
DEBUG=False
ALLOWED_HOSTS=your_domain.com,localhost,127.0.0.1